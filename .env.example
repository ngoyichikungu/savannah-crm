# ==============================================================================
# Savannah Business Operations & CRM — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION METADATA & ENVIRONMENT
# ------------------------------------------------------------------------------
# The user-facing display title for invoices, receipts, and client portals.
APP_NAME="Savannah Business Operations & CRM"

# Application environment: 'production', 'staging', or 'local'.
# Set to 'production' for live deployments.
APP_ENV=production

# Master Cryptographic Secret Key (32-character base64 string).
# Used to encrypt session cookies, financial tokens, and database secrets.
# Generate via web installer at /install or run: php artisan key:generate
APP_KEY=base64:7K0mQx1sL29p3r4t5u6v7w8x9y0z1a2b3c4d5e6f7g8=

# Enable detailed error messages in web interface. Set to 'false' in production.
APP_DEBUG=false

# Full canonical URL where the app is hosted (e.g., https://crm.yourcompany.co.zm).
APP_URL=http://localhost:3000

# The HTTP port on which the web server binds. Default is 3000.
APP_PORT=3000

# ------------------------------------------------------------------------------
# 2. DATABASE & STORAGE ENGINE (MYSQL)
# ------------------------------------------------------------------------------
# Database driver connection. Options: 'mysql', 'pgsql', or 'sqlite'.
DB_CONNECTION=mysql

# MySQL Database connection parameters.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=savannah_crm
DB_USERNAME=root
DB_PASSWORD=secret

# Storage driver for uploaded document logos and attachments.
# Options: 'local' (filesystem) or 's3' (Cloud Storage).
STORAGE_DRIVER=local

# ------------------------------------------------------------------------------
# 3. FINANCIAL & TAX DEFAULT PARAMETERS
# ------------------------------------------------------------------------------
# Default currency code for new companies (ISO 4217, e.g., ZMW, USD, EUR, ZAR).
DEFAULT_CURRENCY=ZMW

# Default Value Added Tax (VAT) rate in basis points (1600 bp = 16.00%).
DEFAULT_VAT_BP=1600

# Default invoice payment terms in days (e.g., 30 days).
DEFAULT_PAYMENT_TERMS_DAYS=30

# ------------------------------------------------------------------------------
# 4. LOGGING, BACKUPS & OPERATIONS
# ------------------------------------------------------------------------------
# Log output destination. Options: 'daily' (rotated log files) or 'stderr'.
LOG_CHANNEL=daily

# Minimum log severity level: 'debug', 'info', 'warning', 'error'.
LOG_LEVEL=info

# Maximum number of daily backup archives retained by 'php artisan app:backup'.
BACKUP_RETENTION_COUNT=10
