# ==============================================================================
# Apache2 VirtualHost Template for Savannah CRM Multi-Instance Deployment
# ==============================================================================
# Variables to replace:
#   {{HTTP_PORT}}       -> VirtualHost port (e.g., 80, 8080, 8081)
#   {{SERVER_NAME}}     -> Domain or subdomain (e.g., crm2.yourcompany.co.zm)
#   {{SERVER_ALIAS}}    -> Optional aliases (e.g., crm2.local)
#   {{DOCUMENT_ROOT}}   -> Path to dist directory (e.g., /var/www/html/crm2/dist)
#   {{INSTANCE_ID}}     -> Instance slug (e.g., crm2)
# ==============================================================================

<VirtualHost *:{{HTTP_PORT}}>
    ServerName {{SERVER_NAME}}
    ServerAlias {{SERVER_ALIAS}}
    ServerAdmin webmaster@localhost
    DocumentRoot {{DOCUMENT_ROOT}}

    <Directory {{DOCUMENT_ROOT}}>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted

        # Single Page Application routing fallback
        <IfModule mod_rewrite.c>
            RewriteEngine On
            RewriteBase /
            RewriteRule ^index\.html$ - [L]
            RewriteCond %{REQUEST_FILENAME} !-f
            RewriteCond %{REQUEST_FILENAME} !-d
            RewriteRule . /index.html [L]
        </IfModule>
    </Directory>

    # Security: Deny direct access to sensitive files and database files
    <FilesMatch "^\.|\.(sql|mysql|sqlite|env|lock)$">
        Require all denied
    </FilesMatch>

    # Instance Isolation Header
    <IfModule mod_headers.c>
        Header always set X-Frame-Options "SAMEORIGIN"
        Header always set X-Content-Type-Options "nosniff"
        Header always set X-Savannah-Instance "{{INSTANCE_ID}}"
    </IfModule>

    # Compression
    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE text/plain text/css application/json application/javascript text/xml application/xml
    </IfModule>

    # Dedicated Isolated Error & Access Logs
    ErrorLog ${APACHE_LOG_DIR}/savannah_{{INSTANCE_ID}}_error.log
    CustomLog ${APACHE_LOG_DIR}/savannah_{{INSTANCE_ID}}_access.log combined
</VirtualHost>
